# Application
SECRET_KEY=change-this-to-a-secure-random-secret-key
DATABASE_URL=postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=tpsodl-pvr
R2_PREFIX=pvr

# Gemini AI (Quality Evaluation)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# PVR Upload Limits
PVR_MAX_UPLOAD_MB=15
